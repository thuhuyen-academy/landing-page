# Biến môi trường mẫu cho dự án Vietnamese with Huyền Hannah
# Không đưa các khóa bí mật vào biến có tiền tố NEXT_PUBLIC_

# URL ứng dụng
NEXT_PUBLIC_APP_URL=https://thuhuyen-academy.github.io/landing-page/
APP_BASE_URL=http://localhost:3000

# Cấu hình Auth0 (Đăng nhập Google / Social SSO qua @auth0/nextjs-auth0 v4)
# Tạo chuỗi ngẫu nhiên 32 byte bằng lệnh: openssl rand -hex 32
AUTH0_SECRET=replace-with-a-32-byte-hex-secret-from-openssl-rand
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret

# Webhook Google Apps Script lưu đăng ký học viên vào Google Sheets + gửi thông báo Gmail
NEXT_PUBLIC_GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbwCxEX1l2Ay_6BpE85S1Ir6Vt0nwVdNwvsZfXnmwoqzpO_9Grq7CS8R7daeR4yqv1if/exec

# Email nhận thông báo học viên đăng ký học thử
NOTIFY_EMAIL=lethithuhuyen2104@gmail.com
